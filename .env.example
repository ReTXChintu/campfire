# Read by ecosystem.config.js (pm2) for the https://<IP>:<PORT> deployment — copy to `.env` at
# the repo root. This is separate from apps/backend/.env and apps/frontend/.env, which hold each
# app's own secrets/config and are unaffected by this file.

# The server's public IP — used by scripts/generate-self-signed-cert.sh to generate a cert with
# the right subjectAltName; not read by the apps themselves.
SERVER_IP=

# Ports pm2 tells each app to listen on.
BACKEND_PORT=50001
FRONTEND_PORT=50000

# Generated by: ./scripts/generate-self-signed-cert.sh (reads SERVER_IP above if no arg is given)
SSL_CERT_PATH=./certs/cert.pem
SSL_KEY_PATH=./certs/key.pem
