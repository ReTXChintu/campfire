# --- NextAuth / Auth.js (v5) ---
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# --- MongoDB ---
MONGODB_URI=
MONGODB_DB_NAME=stream

# --- Google Service Account (Drive access) ---
# base64 of the entire downloaded service-account JSON key file
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=

# --- App config ---
DRIVE_ROOT_FOLDER_ID=

# Comma-separated list of Google account emails allowed to access /admin (upload). Everyone else
# who logs in can still watch, but gets redirected/403'd from admin routes.
ADMIN_EMAILS=
