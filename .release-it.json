{
  "git": {
    "commitMessage": "chore: release v${version}",
    "tagName": "v${version}",
    "requireCleanWorkingDir": true,
    "requireBranch": "main",
    "requireUpstream": false,
    "push": true
  },
  "github": {
    "release": true
  },
  "npm": {
    "publish": false
  },
  "hooks": {
    "after:bump": "npm version ${version} --workspaces --include-workspace-root --no-git-tag-version --allow-same-version && node scripts/sync-mobile-version.mjs ${version}"
  }
}
