# Base URL of the backend API (apps/backend). Baked into the static build at build time.
VITE_API_URL=http://localhost:4000

# Optional — shows a "Get the App" button in the top bar when set (e.g. a link to the .apk/.ipa
# or a Play Store/TestFlight listing). Leave unset to hide the button entirely.
VITE_MOBILE_APP_DOWNLOAD_URL=

# Optional — same idea, for the Windows desktop build (the Inno Setup installer built by
# apps/mobile/windows/installer/campfire.iss, e.g. /Campfire.exe). Leave unset to hide the
# desktop-app link. MKV titles show both links (see DesktopAppRequiredNotice) since MKV isn't
# playable on web at all.
VITE_DESKTOP_APP_DOWNLOAD_URL=
