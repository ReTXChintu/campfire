# --- Server ---
PORT=4000

# Optional — serve HTTPS directly instead of plain HTTP (e.g. self-signed cert for an
# https://<IP>:<PORT> deployment with no reverse proxy). Both unset = plain HTTP.
# The root ecosystem.config.js (pm2) sets these for you from the root .env; only set them here
# directly if you're running the backend standalone, without pm2.
SSL_CERT_PATH=
SSL_KEY_PATH=

FRONTEND_URL=http://localhost:5173

# --- Login (one seeded admin account; everyone else can sign up from the login screen) ---
# The admin account is seeded into Mongo on every startup — edit these and restart the backend to
# change the email/password. No Google login.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Session / media JWT signing secrets (generate with: openssl rand -base64 32) ---
AUTH_JWT_SECRET=
MEDIA_TOKEN_SECRET=

# --- MongoDB ---
MONGODB_URI=
MONGODB_DB_NAME=stream

# --- Google Service Account (Drive access) ---
# base64 of the entire downloaded service-account JSON key file
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=

# --- App config ---
DRIVE_ROOT_FOLDER_ID=

# --- ffmpeg/ffprobe (optional) ---
# Both default to relying on PATH. Set these to absolute paths (`which ffmpeg` / `which ffprobe`)
# if you see "spawn ffmpeg ENOENT" / "spawn ffprobe ENOENT" — a common gotcha under pm2, whose
# daemon's PATH doesn't always match your interactive shell's (e.g. nvm/asdf-installed tools, or
# anything only added in .bashrc).
FFMPEG_PATH=
FFPROBE_PATH=
