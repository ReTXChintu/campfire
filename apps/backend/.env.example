# --- Server ---
PORT=4000

# Optional — serve HTTPS directly instead of plain HTTP (e.g. self-signed cert for an
# https://<IP>:<PORT> deployment with no reverse proxy). Both unset = plain HTTP.
# The root ecosystem.config.js (pm2) sets these for you from the root .env; only set them here
# directly if you're running the backend standalone, without pm2.
SSL_CERT_PATH=
SSL_KEY_PATH=

# --- Google OAuth (Passport) ---
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials — add
# AUTH_CALLBACK_URL below as an authorized redirect URI on that client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_CALLBACK_URL=http://localhost:4000/auth/google/callback
FRONTEND_URL=http://localhost:5173

# --- Session / media JWT signing secrets (generate with: openssl rand -base64 32) ---
AUTH_JWT_SECRET=
MEDIA_TOKEN_SECRET=

# --- Mobile app (apps/mobile) Google Sign-In — optional, only needed once the mobile app is set up ---
# The Android/iOS OAuth client IDs from the same Google Cloud project (see apps/mobile/README.md).
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# --- MongoDB ---
MONGODB_URI=
MONGODB_DB_NAME=stream

# --- Google Service Account (Drive access) ---
# base64 of the entire downloaded service-account JSON key file
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=

# --- App config ---
DRIVE_ROOT_FOLDER_ID=

# Comma-separated list of Google account emails allowed to access /admin.
ADMIN_EMAILS=
