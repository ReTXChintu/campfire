<?xml version="1.0" encoding="utf-8"?>
<!--
  Trusts the backend's self-signed cert (raw/backend_cert.pem, copied in by
  scripts/generate-self-signed-cert.sh) for ExoPlayer/video_player's native networking — the Dart
  side is handled separately by services/backend_trust_io.dart, since Dart's own HTTP stack
  doesn't go through Android's OS networking layer at all and isn't affected by this file.

  A base-config (not scoped to one domain) so this doesn't need editing every time the server's
  IP changes — it ADDS this one cert as an extra trusted anchor alongside the normal system CA
  list (the "system" keyword below — note: no "@", that sigil is only for @resource references
  like @raw/backend_cert; "system"/"user" are the two special keywords), it doesn't replace
  anything, so HTTPS to any other real (CA-signed) host still validates normally. The cert's own
  subjectAltName still locks it to whatever IP it was generated for, so this doesn't let it
  impersonate other domains.
-->
<network-security-config>
    <base-config>
        <trust-anchors>
            <certificates src="@raw/backend_cert" />
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
